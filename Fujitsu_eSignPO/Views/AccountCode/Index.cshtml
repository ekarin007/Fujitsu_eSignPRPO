@{
    ViewData["Title"] = "Account Code List";
}
<link href="~/css/select2.min.css" rel="stylesheet" />
<link href="~/css/ui-autocomplete.css" rel="stylesheet" />
<link href="~/datatables/css/datatables.bootstrap5.min.css" rel="stylesheet" />
<div class="card o-hidden border-0 shadow-sm mt-1 mb-2">
    <div class="card-header bg-primary">
        <h4 class="text-white">Import Account Code</h4>
    </div>
    <div class="card-body">
        <div class="d-flex">
            <div class="form-inline small">
                <div class="form-group m-1">
                    <label for="file">Select Excel File: &nbsp;</label>
                    <input type="file" id="file" class="form-control form-control-sm" accept=".xlsx" />
                </div>
                <div class="form-group">
                    <button id="uploadBtn" class="btn btn-sm btn-primary">Upload</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card o-hidden border-0 shadow-sm mt-1 mb-2">
    <div class="card-header bg-primary">
        <h4 class="text-white">Export Account Code</h4>
    </div>
    <div class="card-body">
        <div class="d-flex">
            <div class="form-inline small">
                <div class="form-group m-1">
                    <label for="datestart">
                        Main Code : &nbsp;
                        <select id="mainCode" class="form-control form-control-sm">
                            <option value="">---Select Main Code ---</option>
                            @foreach (var mc in ViewBag.MainCode)
                            {
                                <option value="@mc">@mc</option>

                            }
                        </select>
                    </label>
                </div>
                @*  <div class="form-group m-1">
                <label for="datestart">
                Sub Code 1 : &nbsp;
                <select id="subCode1" class="form-control form-control-sm">
                <option value="">---Select Sub Code 1 ---</option>
                @foreach (var sc1 in ViewBag.SubCode1)
                {
                <option value="@sc1">@sc1</option>
                }
                </select>
                </label>
                </div>*@

                <br />
                <div class="form-group"> <button type="button" class="btn btn-info btn-sm" id="searchBtn" style="width:100%"><i class="fa fa-search"></i> Search</button></div>
                <div class="form-group m-1">

                    <button class="btn btn-success btn-sm" id="exportExcel" style="width:100%"><i class="fa fa-file-excel"></i> Export</button>
                </div>


            </div>
        </div>
    </div>
</div>


<div class="card o-hidden border-0 shadow-sm mt-1">
    <div class="card-header ">
        <div class=" d-flex justify-content-between align-items-center">
            <div>
                <h4>Account Code List</h4>
            </div>

            <div> <a href="@Url.Action("InsertUpdate","AccountCode")" class="btn btn-success btn-sm w-100"><i class="fa fa-plus"></i> Create</a></div>



        </div>

        <div class="row d-flex align-items-end">
            <div class="col-lg-12 col-md-12 col-sm-12">
            </div>
        </div>
    </div>
    <div class="card-body ">
        <div class="table-responsive">
            <table id="cusList" class="table table-striped text-center table-bordered align-self-center table-hover w-100 table-sm small">
                <thead>
                    <tr class="bg bg-primary text-white">
                        <th>Main Code</th>
                        <th>Sub Code 1</th>
                        <th>Sub Code 2</th>
                        <th>Budget</th>
                        <th>Balance</th>
                        <th>Active</th>
                        <th>#Action</th>
                    </tr>
                </thead>

            </table>
        </div>
    </div>

</div>
@section Scripts {

    <script src="~/js/moment.min.js"></script>
    <script src="~/datatables/js/jquery.datatables.min.js"></script>
    <script src="~/datatables/js/datatables.bootstrap5.js"></script>
    <script src="~/js/select2.min.js"></script>
    <script>
        $(function () {

              $('#uploadBtn').click(function () {
                var fileInput = $('#file')[0].files[0];

                if (!fileInput) {
                    alert('Please select a file.');
                    return;
                }

                var formData = new FormData();
                formData.append('file', fileInput);

                $.ajax({
                url: '@Url.Action("upload", "accountCode")',
                type: 'POST',
                data: formData,
                contentType: false,
                processData: false,
                success: function (response) {

                    alert(response.message);
                    var url = '@Url.Action("index", "AccountCode")';
                    window.location.href = url;
                },
                error: function (xhr) {
                     alert(xhr.responseText);
                }
            });


              });



            $("#mainCode").select2({


            });

            $("#subCode1").select2({


            });

            $('#searchBtn').click(function () {


               $("#cusList").DataTable().destroy();
                //$('#cusList').empty();

                $("#cusList").DataTable({
                    "order": [[0, "desc"]],
                    "scrollX": true,
                    "ajax": {
                        "url": '@Url.Action("getAccountCodeByMainCode", "AccountCode")?MC=' + $("#mainCode").val(),

                        "type": "GET",
                        "datatype": "json"
                    },
                    "columns": [
                        {
                            "data": "mainCode", "render": function (data, type, row, meta) {
                                return "<a href='@Url.Action("insertupdate", "AccountCode")?uAccId=" + row.uAcGuid + "'>" + data + "</a>";
                            }
                        },
                        { "data": "subCode1" },
                        { "data": "subCode2" },
                        {

                            "data": "budget", "render": function (data) {
                                if (data != "") {
                                    var formattedData = data.toLocaleString('en-US', {
                                        style: 'decimal',
                                        minimumFractionDigits: 2,
                                        maximumFractionDigits: 2
                                    });
                                    return formattedData;
                                }
                                return "";
                            }
                        },
                        {
                            "data": "balance", "render": function (data) {

                                if (data != "") {
                                    var formattedData = data.toLocaleString('en-US', {
                                        style: 'decimal',
                                        minimumFractionDigits: 2,
                                        maximumFractionDigits: 2
                                    });
                                    return formattedData;
                                }

                                return "";
                            }
                        },
                        { "data": "active" },
                        {
                            "data": "uAcGuid", "render": function (data, type, row, meta) {



                                return "<button type='button' onclick='DeleteAccCode(\"" + data + "\")' class='btn btn-danger btn-circle btn-sm'><i class='fas fa-trash' aria-hidden='true'></i></button>";

                            }
                        }
                    ]

                });

            });


            $('#exportExcel').click(function () {


                var url = '@Url.Action("ExportAccCode", "AccountCode")';
                var mainCode = $('#mainCode').val();
                var subCode1 = $('#subCode1').val();

                if (mainCode != '' && subCode1 != '') {
                    // window.location.href = url + '?mc=' + mainCode + '&sc1=' + subCode1;
                    window.location.href = url + '?mc=' + mainCode;
                } else {
                    alert("Warning : Please enter main code and sub code 1.");
                    return
                }


            });



            $("#cusList").DataTable({
                "order": [[0, "desc"]],
                "scrollX": true,
                "ajax": {
                    "url": '@Url.Action("getAccountCode", "AccountCode")',
                    "type": "GET",
                    "datatype": "json"
                },
                "columns": [
                    {
                        "data": "mainCode", "render": function (data, type, row, meta) {
                            return "<a href='@Url.Action("insertupdate", "AccountCode")?uAccId=" + row.uAcGuid + "'>" + data + "</a>";
                        }
                    },
                    { "data": "subCode1" },
                    { "data": "subCode2" },
                    {

                        "data": "budget", "render": function (data) {
                            if (data != "") {
                                var formattedData = data.toLocaleString('en-US', {
                                    style: 'decimal',
                                    minimumFractionDigits: 2,
                                    maximumFractionDigits: 2
                                });
                                return formattedData;
                            }
                            return "";
                        }
                    },
                    {
                        "data": "balance", "render": function (data) {

                            if (data != "") {
                                var formattedData = data.toLocaleString('en-US', {
                                    style: 'decimal',
                                    minimumFractionDigits: 2,
                                    maximumFractionDigits: 2
                                });
                                return formattedData;
                            }

                            return "";
                        }
                    },
                    { "data": "active" },
                    {
                        "data": "uAcGuid", "render": function (data, type, row, meta) {



                            return "<button type='button' onclick='DeleteAccCode(\"" + data + "\")' class='btn btn-danger btn-circle btn-sm'><i class='fas fa-trash' aria-hidden='true'></i></button>";

                        }
                    }
                ]

            });
        });

        function DeleteAccCode(data) {
            var confirmation = confirm('Are you sure you want to delete this Account Code?');

            if (!confirmation) {
                return;
            }
            $.ajax({
                type: 'POST',
                url: '@Url.Action("deleteAccountCode", "AccountCode")',
                data: { guid: data },
                success: function (result) {

                    alertPopup(`${result.msg}`).then((result) => {
                        if (result.isConfirmed) {
                            var url = '@Url.Action("index", "AccountCode")';
                            window.location.href = url;
                        }
                    });
                    console.log(result);
                },
                error: function (result) {
                    alertErrorPopup(`Failed to Delete the Data : ${result.responseJSON.msg}`);

                }
            });

        }



    </script>
}
