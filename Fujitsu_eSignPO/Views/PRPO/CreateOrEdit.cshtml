          function checkProjectName(){
               var _subCode1 = $("#subCode1").val();

               if (!restrictedCodes.includes(_subCode1)) {
                 $('.projectName').val('');
                 $('.projectName').prop('disabled', true);     // disable when enable
                 $('input[name="projectType"]').prop('disabled', true);
               }else{
                 $('.projectName').prop('disabled', false);     // enable when disable
                 $('input[name="projectType"]').prop('disabled', false);
               }
          }

          function editPrItem(guid) {

              clearAddRowModalFields();

              $("#itemHeader").text("Edit");
              $("#itemBtn").text("Update !");
              $('#addRowModal').modal('show');

              $.ajax({
                  url: "@Url.Action("getPrItemById", "PRPO")",
                  type: "GET",
                  data: { prItemId: `${guid}` },
                  success: function (response) {
                      console.log(response);
                       checkProjectName();
                      $("#itemGuid").val(response.uPrItemId);
                      $("#order").val(response.nNo);
                      $("#partNo").val(response.sPartNo);
                      $("#partName").val(response.sPartName);
                      $("#vatType").val(response.sVatType);
                      $("#unitPrice").val(response.fUnitPrice);
                      $("#qty").val(response.fQty);
                     let projectName = response.sProject;

                     var radioFound = false;
                     if(projectName){

                      $('input[name="projectType"]').each(function() {
                       if ($(this).val() === projectName) {
                            $(this).prop('checked', true);
                             radioFound = true;
                           }
                       });

                        if (!radioFound) {
                           $('#projectName').val(projectName);
                        }
                     }
                  },
                  error: function (xhr, status, error) {

                      alert("Failed to fetch data.");
                  }
              });

          }

          function deletePrItem(guid) {

              var delConfirm = confirm("Are you sure you want to delete this item?");
              if (delConfirm) {
                  $.ajax({
                      url: "@Url.Action("deleteItemById", "PRPO")",
                      type: "POST",
                      data: { prItemId: `${guid}` },
                      success: function (response) {
                          $('#listPOItem').DataTable().ajax.reload(function () {
                                      calculateTotalAmount();
                                  }, false);
                      },
                      error: function (xhr, status, error) {

                          alert("Failed to fetch data.");
                      }
                  });
              }
          }

       function loadPartial() {

        let amountText = $('#totalAmountTHB').val().replace(/,/g, '');
        let totalAmount = parseFloat(amountText) || 0;

        if (totalAmount < 50000) {
            alert("The total amount must be greater than 50,000 THB to proceed with the compare form.");
            return; 
        }
                  
                    let poGuid= "@Context.Request.Query["gID"]";
                        $.get("@Url.Action("compareForm", "PRPO")",{poGuid:poGuid}, function (data) {
              $("#modalCompareContent").html(data);

              const modalElement = document.getElementById('compareModal');
              compareModalInstance  = new bootstrap.Modal(modalElement, {
                  backdrop: 'static',
                  keyboard: false
              });
              compareModalInstance.show();

              setTimeout(() => {

              initCompareTable(poGuid);

              },300);

          });



       }

          function initCompareTable(poGuid) {
              if (!$.fn.DataTable.isDataTable('#compareTable')) {
                  compareTable = $('#compareTable').DataTable({
                      ajax: {
                            url: `@Url.Action("GetCompareItemById", "PRPO")?guid=${poGuid}`,
                          dataSrc: ''
                      },
                      columns: [
                          {
                              data: null,
                              render: (data, type, row, meta) => meta.row + 1
                          },
                          { data: 'sCpItem' },
                          { data: 'sBrandModel' },
                          { data: 'fAmount' , "render": function (data, type, row, meta) {

                              var formattedAmount = data.toLocaleString('en-US', {
                                  style: 'decimal',
                                  minimumFractionDigits: 2,
                                  maximumFractionDigits: 2
                              });

                              return formattedAmount;

                          }
                          },
                          { data: 'fVendorAmount1' , "render": function (data, type, row, meta) {

                              var formattedAmount = data.toLocaleString('en-US', {
                                  style: 'decimal',
                                  minimumFractionDigits: 2,
                                  maximumFractionDigits: 2
                              });

                              return formattedAmount;

                          } },
                          { data: 'fVendorAmount2', "render": function (data, type, row, meta) {

                              var formattedAmount = data.toLocaleString('en-US', {
                                  style: 'decimal',
                                  minimumFractionDigits: 2,
                                  maximumFractionDigits: 2
                              });

                              return formattedAmount;

                          } },
                          {
                              data: 'uGuid',
                              render: (data) =>
                                     `<button type="button" class="btn btn-primary btn-sm mr-1" onclick="openEditCompareModal('${data}')"><i class="fa fa-edit"></i></button><button type="button" class="btn btn-danger btn-sm" onclick="deleteCompare('${data}')"><i class="fa fa-trash"></i></button>`
                          }
                      ],
                      searching: false,
                      lengthChange: false
                  });
              } else {
                  compareTable.ajax.reload();
              }
          }

          function deleteCompare(guid) {

              var delCompare = confirm("Are you sure you want to delete this compare item?");
              if (delCompare) {
                $.post('@Url.Action("DeleteCompareItem", "PRPO")',    { guid }, function (res) {
                    if (res.success) {
                        compareTable.ajax.reload(null, false);
                    }else{
                        alert(res.message);
                    }
                });
              }
          }

    </script>
