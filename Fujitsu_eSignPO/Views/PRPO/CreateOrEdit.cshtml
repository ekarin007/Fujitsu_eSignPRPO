           function openAddRowModal() {
               clearAddRowModalFields();

               if (!validateAdd()) return false;

               checkProjectName();

                var vatOption = $("#vatOption").val();
                $("#vatType").val(vatOption);


               $('#addRowModal').modal('show');


               }
           function clearAddRowModalFields() {
               const modal = $('#addRowModal');

               // เคลียร์ input ทั้งหมด (text, number, hidden)
               modal.find('input[type="text"], input[type="number"], input[type="hidden"]').val('');

               // เคลียร์ textarea
               modal.find('textarea').val('');

               // เคลียร์ select
               modal.find('select').prop('selectedIndex', 0); // หรือใช้ .val('') ถ้าต้องการ default null

               // เคลียร์ radio buttons
               modal.find('input[type="radio"]').prop('checked', false);
           }

           function calculateTotalAmount() {

               debugger;
              let table = $('#listPOItem').DataTable(); // 👈 แทน yourTableId ด้วย id ของตารางคุณ
              let totalAmount = 0;

              // ลูปอ่าน column "Amount" (สมมติว่าเป็นคอลัมน์ที่ 7 → index = 6)
              table.rows({ search: 'applied' }).every(function () {
                  debugger;
                  let data = this.data();
                  let amount = parseFloat(data.fAmount) || 0; // เปลี่ยน index ให้ตรงกับ "Amount" จริง
                  totalAmount += amount;
              });

              $('#totalAmount').val(totalAmount.toFixed(2));
               var rate = $("#rate").val();
              if (rate == "" || rate == 0) rate = "1";

              let totalInTHB = totalAmount * rate;

              $('#totalAmountTHB').val(totalInTHB.toFixed(2));


          }

          function calculateVAT(vat) {

              $('#vatAmount').val(vat.toFixed(2));

          }



