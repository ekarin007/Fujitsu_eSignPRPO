                        </div>
                        <div>
                            <input type="radio" id="typeD" name="projectType" value="No Project" />
                            <label for="typeD">No Project</label>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" id="cancelPJBtn">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveProjectBtn">Save</button>
            </div>
        </div>
    </div>
</div>
