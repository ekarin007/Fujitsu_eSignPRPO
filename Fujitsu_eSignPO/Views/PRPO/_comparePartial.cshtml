@model Fujitsu_eSignPO.Models.PRPO.comparePOModel
<style>
    .is-invalid {
        border: 2px solid red;
    }

    label.required::after {
        content: " *";
        color: red;
    }
</style>
<div class="row">

    <div class="form-group col-6">
        <label>Budget this month</label>
        <input type="number" id="budgetCompare" class="form-control form-control-sm" asp-for="fBudget" />
    </div>
    <div class="form-group col-6">
        <label>Balance</label>
        <input type="number" id="balanceCompare" class="form-control form-control-sm" asp-for="fBalance" />
    </div>

</div>
<div class="row">

    <div class="form-group col-6">
        <label class="required">Vendor 1 Winner</label>
        <input type="text" id="vendor1" class="form-control form-control-sm" asp-for="sVendor1" />


    </div>
    <div class="form-group col-6">
        <label>Vendor 2</label>
        <input type="text" id="vendor2" class="form-control form-control-sm" asp-for="sVendor2" />

    </div>

</div>
<div class="row">

    <div class="form-group col-6">
        <label>Vendor 1 Quatation Date</label>
        <input type="date" id="vdr1Date" class="form-control form-control-sm" asp-for="dVdr1_Quotation_Date" />
    </div>
    <div class="form-group col-6">
        <label>Vendor 2 Quatation Date</label>
        <input type="date" id="vdr2Date" class="form-control form-control-sm" asp-for="dVdr2_Quotation_Date" />
    </div>

</div>

<div class="row">

    <div class="form-group col-6">
        <label>Vendor Result</label>
        <input type="text" id="vendorResult" class="form-control form-control-sm" asp-for="sVendorResult" />
    </div>
    <div class="form-group col-6">
        <label>Remark Result</label>
        <textarea cols="5" id="remarkCompare" class="form-control form-control-sm" asp-for="sRemarkResult"> </textarea>
    </div>

</div>
<div class="row">

    <div class="form-group col-6">
        <label>Total Price Result</label>
        <input type="number" id="totalPriceResult" class="form-control form-control-sm" asp-for="fTotalPriceResult" />
    </div>


</div>



<hr />
