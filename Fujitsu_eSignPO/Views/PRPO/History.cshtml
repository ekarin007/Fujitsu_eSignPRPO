@using System.Security.Claims;
@{
    ViewData["Title"] = "History";
}
<link href="~/datatables/css/datatables.bootstrap5.min.css" rel="stylesheet" />
<div class="card o-hidden border-0 shadow-sm ">
    <div class="card-body ">
        <div class="d-flex row align-items-center justify-content-end mb-2">
            <div class="mr-auto p-2 text-center"><span class="h5 mb-0 text-gray-800 font-weight-bold">LIST PURCHASE ORDER</span> </div>
            <div class="d-flex justify-content-center align-items-center">
                <div class="form-inline small">
                    <div class="form-group m-1">
                        <label for="datestart">
                            Start Date : &nbsp;
                            <input class="form-control form-control-sm" id="dateStart" type="date" />
                        </label>
                    </div>
                    <div class="form-group m-1">
                        <label for="datestart">
                            End Date : &nbsp;
                            <input class="form-control form-control-sm" id="dateEnd" type="date" />
                        </label>
                    </div>
                    <div class="form-group m-1">
                        <label for="flowStatus">
                            Status : &nbsp;
                            <select id="flowStatus" name="flowStatus" class="form-control form-control-sm">
                                <option value="">-----ALL-----</option>
                                <option value="0">Re-Submit</option>
                                <option value="1">Submitted</option>
                                <option value="2">Department Mgr Approved</option>
                                <option value="3">Account Approved</option>
                                <option value="4">Wait invoice</option>
                                <option value="5">Completed</option>
                                <option value="6">Rejected</option>
                                <option value="9">Canceled</option>
                            </select>
                        </label>
                    </div>
                    <br />
                    <div class="form-group m-1">

                        <button class="btn btn-primary btn-sm" id="invoiceExport" style="width:100%" onclick="getHistoryData()"><i class="fa fa-search"></i> Search</button>

                    </div>
                    @{
                        var claimsValue = User.Claims.Where(x => x.Type == ClaimTypes.Role).Select(claim => new { claim.Value }).FirstOrDefault();
                        var claimsName = User.Claims.Where(x => x.Type == ClaimTypes.Name).Select(claim => new { claim.Value }).FirstOrDefault();
                        var claimsTitle = User.Claims.Where(x => x.Type == "Title").Select(claim => new { claim.Value }).FirstOrDefault();
                        var sId = User.Claims.Where(x => x.Type == ClaimTypes.Sid).Select(claim => new { claim.Value }).FirstOrDefault();
                    }
                    @if (claimsValue?.Value == "2" || claimsValue?.Value == "1" || claimsValue?.Value == "0")
                    {
                        <div class="form-group m-1">
                            <button class="btn btn-success btn-sm" id="exportExcel" style="width:100%"><i class="fa fa-file-excel"></i> Export Excel (All PO)</button>
                        </div>
                    }

                </div>
            </div>

        </div>
    </div>
</div>
<div class="card o-hidden border-0 shadow-sm mt-1">
    <div class="card-header bg-primary">
        <div class="row d-flex">
            <h2 class="text-white">History</h2>
        </div>

        <div class="row d-flex align-items-end">
            <div class="col-lg-12 col-md-12 col-sm-12">
            </div>
        </div>
    </div>
    <div class="card-body ">
        <div class="table-responsive">
            <table id="worklist" class="table table-striped text-center table-bordered align-self-center table-hover w-100 table-sm small">
                <thead>
                    <tr class="bg bg-primary text-white">
                        <th>PO Number</th>
                        <th>Supplier Name</th>
                        <th>Main Code</th>
                        <th>Sub Code 1</th>
                        <th>Sub Code 2</th>
                        <th>Amount [currency]</th>
                        <th>Amount [THB.]</th>
                        <th>Status</th>
                        <th>Created Date</th>
                        <th>#Action</th>
                    </tr>
                </thead>

            </table>
        </div>
    </div>

</div>
@section Scripts{
    <script src="~/js/moment.min.js"></script>
    <script src="~/datatables/js/jquery.datatables.min.js"></script>
    <script src="~/datatables/js/datatables.bootstrap5.js"></script>
    <script>
        $(function () {
            getHistoryData();

            $('#exportExcel').click(function () {


                var url = '@Url.Action("ExportAllPR", "PRPO")';
                var datestart = $('#dateStart').val();
                var dateEnd = $('#dateEnd').val();
                var flowStatus = $("#flowStatus").val()

                if (datestart == '' && dateEnd == '') {
                    alert("Warning : Please enter date time before export excel file.");
                    return
                }

                window.location.href = url + '?datestart=' + datestart + '&dateend=' + dateEnd + '&flowStatus=' + flowStatus;
            });
        });

        function getHistoryData() {
            $("#worklist").DataTable({
                "order": true,
                "scrollX": true,
                "bDestroy": true,
                "ajax": {
                    "url": '@Url.Action("getHistory", "PRPO")',
                    "type": "GET",
                    "datatype": "json",
                    "data": { dateStart: $("#dateStart").val(), dateEnd: $("#dateEnd").val(), flowStatus: $("#flowStatus").val() }
                },
                "columns": [
                    {
                        "data": "sPoNo", "render": function (data, type, row, meta) {

                            return "<a href='@Url.Action("ApprovePR","PRPO")/" + data + "'>" + data + "</a>";

                        }
                    },
                    { "data": "sSupplierName" },
                    { "data": "sMainCode" },
                    { "data": "sSubCode1" },
                    { "data": "sSubCode2" },
                    {
                        "data": "fSumAmtCurrency", "render": function (data, type, row, meta) {


                            var SumAmtCurrency = parseFloat(data);
                            var formattedAmount = SumAmtCurrency.toLocaleString('en-US', {
                                style: 'decimal',
                                minimumFractionDigits: 2,
                                maximumFractionDigits: 2
                            });

                            return formattedAmount;

                        }
                    },
                    {
                        "data": "fSumAmtThb", "render": function (data, type, row, meta) {

                            var SumAmtTHB = parseFloat(data);
                            var formattedAmount = SumAmtTHB.toLocaleString('en-US', {
                                style: 'decimal',
                                minimumFractionDigits: 2,
                                maximumFractionDigits: 2
                            });

                            return formattedAmount;

                        }
                    },
                    {
                        "data": "sStatus", "render": function (data, type, row, meta) {


                            if (row.nStatus < 5) {
                                return `<div class='alert alert-warning'>${data}</div>`;
                            } else if (row.nStatus == 5) {
                                return `<div class='alert alert-success'>${data}</div>`;
                            }
                            else if (row.nStatus > 5) {
                                return `<div class='alert alert-danger'>${data}</div>`;
                            }


                        }
                    },

                    {
                        "data": "dCreated", "render": function (data, type, row, meta) {

                            return moment(data).format("DD-MM-YYYY HH:mm:ss");

                        }
                    },
                    {
                        "data": "sStatus", "render": function (data, type, row, meta) {

                            debugger;
                            if (row.sCreatedBy == '@sId.Value' && (row.nStatus == 0 || row.nStatus == 1 || row.nStatus == 4)) {

                                var updateBtn = "<a href='@Url.Action("CreateOrEdit","PRPO")?gID=" + row.uPoID + "' class='btn btn-primary btn-circle btn-sm'><i class='fas fa-edit' aria-hidden='true'></i></a>";
                                var deleteBtn = "";

                                return updateBtn + deleteBtn;
                            }

                            var positionLevel = '@claimsValue.Value';

                            if (positionLevel == '2' && row.nStatus >= 4) {
                                var updateBtn = "<a href='@Url.Action("CreateOrEdit","PRPO")?gID=" + row.uPoID + "' class='btn btn-primary btn-circle btn-sm'><i class='fas fa-edit' aria-hidden='true'></i></a>";
                                var deleteBtn = "";

                                return updateBtn + deleteBtn;
                            } 

                            return "";

                        }
                    }

                ]



            });
        }
    </script>
}