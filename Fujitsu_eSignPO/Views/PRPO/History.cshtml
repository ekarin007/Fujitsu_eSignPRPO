@using System.Security.Claims;
@{
    ViewData["Title"] = "History";
}
<link href="~/datatables/css/datatables.bootstrap5.min.css" rel="stylesheet" />
<link href="~/css/select2.min.css" rel="stylesheet" />
<link href="~/css/ui-autocomplete.css" rel="stylesheet" />
<style>
    .select2-container {
        width: 100% !important;
        font-size: 1rem; /* Bootstrap 5 default font size */
        font-weight: 400; /* Normal weight */
        line-height: 1.5; /* Adjust line height for better readability */
    }

    .select2-selection {
        min-width: 0;
    }

</style>
<div id="loading-overlay" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background-color:rgba(0,0,0,0.5); z-index:9999;">
    <div style="position:absolute; top:50%; left:50%; transform:translate(-50%, -50%); text-align:center; color:white;">
        <div class="spinner-border text-light" role="status">
            <span class="sr-only">Loading...</span>
        </div>
        <p style="margin-top:10px;">Loading...</p>
    </div>
</div>
<div class="card o-hidden border-0 shadow-sm ">
    <div class="card-body ">
        <div class="container-fluid mb-3">
            <!-- Title -->
            <div class="row mb-3">
                <div class="col text-center">
                    <span class="h5 text-gray-800 font-weight-bold">LIST PURCHASE ORDER</span>
                </div>
            </div>

            <!-- Row 1 -->
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="dateStart">Start Date:</label>
                        <input type="date" id="dateStart" class="form-control form-control-sm" />
                    </div>
                    <div class="form-group">
                        <label for="flowStatus">Status:</label>
                        <select id="flowStatus" class="form-control form-control-sm">
                            <option value="">-----ALL-----</option>
                            <option value="0">Re-Submit</option>
                            <option value="1">Submitted</option>
                            <option value="2">Department Mgr Approved</option>
                            <option value="3">Account Approved</option>
                            <option value="4">Wait invoice</option>
                            <option value="5">Completed</option>
                            <option value="6">Rejected</option>
                            <option value="9">Canceled</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="vendorName">Vendor:</label>
                        <select id="vendorName" class="form-control form-control-sm">
                            <option value="">--- Select Vendor ---</option>
                            @foreach (var vendor in ViewBag.Vendor)
                            {
                                <option value="@vendor.VendorName">@vendor.VendorName</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="project">Project Name:</label>
                        <input type="text" id="project" class="form-control form-control-sm" />
                    </div>
                    <div class="form-group">

                        <label for="subCode1">Sub Code 1:</label>
                        <select id="subCode1" class="form-control form-control-sm">
                            <option value="">--- Select Sub Code 1 ---</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="subCode3">Sub Code 3:</label>
                        <select id="subCode3" class="form-control form-control-sm">
                            <option value="">--- Select Sub Code 3 ---</option>
                        </select>
                    </div>
                
                </div>

                <!-- Right column -->
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="dateEnd">End Date:</label>
                        <input type="date" id="dateEnd" class="form-control form-control-sm" />
                    </div>
                    <div class="form-group">
                        <label for="department">Department:</label>
                        <select id="department" class="form-control form-control-sm">
                            <option value="">--- Select Department ---</option>
                            @foreach (var depItem in ViewBag.departments)
                            {
                                <option value="@depItem.PreCode">@depItem.DepartmentName</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="reqName">Requestor Name:</label>
                        <input type="text" id="reqName" class="form-control form-control-sm" />
                    </div>
                    <div class="form-group">
                        <label for="mainCode">Main Code:</label>
                        <select id="mainCode" class="form-control form-control-sm">
                            <option value="">--- Select Main Code ---</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="subCode2">Sub Code 2:</label>
                        <select id="subCode2" class="form-control form-control-sm">
                            <option value="">--- Select Sub Code 2 ---</option>
                        </select>
                    </div>
                 
                </div>
            </div>

            <!-- Buttons -->
            <div class="row mt-3">
                <div class="col text-center">
                    <button class="btn btn-primary btn-sm" id="invoiceExport" onclick="getHistoryData()">
                        <i class="fa fa-search"></i> Search
                    </button>

                    @{
                        var claimsValue = User.Claims.Where(x => x.Type == ClaimTypes.Role).Select(claim => new { claim.Value }).FirstOrDefault();
                        var claimsName = User.Claims.Where(x => x.Type == ClaimTypes.Name).Select(claim => new { claim.Value }).FirstOrDefault();
                        var claimsTitle = User.Claims.Where(x => x.Type == "Title").Select(claim => new { claim.Value }).FirstOrDefault();
                        var sId = User.Claims.Where(x => x.Type == ClaimTypes.Sid).Select(claim => new { claim.Value }).FirstOrDefault();
                    }
                    @if (claimsValue?.Value == "2" || claimsValue?.Value == "1" || claimsValue?.Value == "0")
                    {
                        <button class="btn btn-success btn-sm" id="exportExcel">
                            <i class="fa fa-file-excel"></i> Export Excel (All PO)
                        </button>
                    }
                </div>
            </div>
        </div>


    </div>
</div>
<div class="card o-hidden border-0 shadow-sm mt-1">
    <div class="card-header bg-primary">
        <div class="row d-flex">
            <h2 class="text-white">History</h2>
        </div>

        <div class="row d-flex align-items-end">
            <div class="col-lg-12 col-md-12 col-sm-12">
            </div>
        </div>
    </div>
    <div class="card-body ">
        <div class="table-responsive">
            <table id="worklist" class="table table-striped text-center table-bordered align-self-center table-hover w-100 table-sm small">
                <thead>
                    <tr class="bg bg-primary text-white">
                        <th>PO Number</th>
                        <th>Supplier Name</th>
                        <th>Main Code</th>
                        <th>Sub Code 1</th>
                        <th>Sub Code 2</th>
                        <th>Amount [currency]</th>
                        <th>Amount [THB.]</th>
                        <th>Status</th>
                        <th>Created Date</th>
                        <th>#Action</th>
                    </tr>
                </thead>

            </table>
        </div>
    </div>

</div>
@section Scripts {
    <script src="~/js/select2.min.js"></script>
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>
    <script src="~/js/moment.min.js"></script>
    <script src="~/datatables/js/jquery.datatables.min.js"></script>
    <script src="~/datatables/js/datatables.bootstrap5.js"></script>

    <script>
        $(function () {
           
            

            getHistoryData();
            getMainCode();
             getSubCode1();
             getSubCode2();
             getSubCode3();

            $('#exportExcel').click(function () {


                var url = '@Url.Action("ExportAllPR", "PRPO")';
                var datestart = $('#dateStart').val();
                var dateEnd = $('#dateEnd').val();
                var flowStatus = $("#flowStatus").val()

                if (datestart == '' && dateEnd == '') {
                    alert("Warning : Please enter date time before export excel file.");
                    return
                }

                window.location.href = url + '?datestart=' + datestart + '&dateend=' + dateEnd + '&flowStatus=' + flowStatus;
            });



        });

        function getMainCode(){
              $('#mainCode').select2({
                 ajax: {
                     url: '@Url.Action("mainCodeData", "PRPO")',
                     dataType: 'json',
                     delay: 250,
                     data: function (params) {
                         return {
                             searchTerm: params.term // Pass the searchTerm parameter
                         };
                     },
                     processResults: function (data) {
                         return {
                             results: data
                         };
                     },
                     cache: true

                 },
                 minimumInputLength: 0
             });
        }
         function getSubCode1(){
              $('#subCode1').select2({
                 ajax: {
                     url: '@Url.Action("SC1Data", "PRPO")',
                     dataType: 'json',
                     delay: 250,
                     data: function (params) {
                         return {
                             searchTerm: params.term // Pass the searchTerm parameter
                         };
                     },
                     processResults: function (data) {
                         return {
                             results: data
                         };
                     },
                     cache: true

                 },
                 minimumInputLength: 0
             });
        }
         function getSubCode2(){
              $('#subCode2').select2({
                 ajax: {
                     url: '@Url.Action("SC2Data", "PRPO")',
                     dataType: 'json',
                     delay: 250,
                     data: function (params) {
                         return {
                             searchTerm: params.term // Pass the searchTerm parameter
                         };
                     },
                     processResults: function (data) {
                         return {
                             results: data
                         };
                     },
                     cache: true

                 },
                 minimumInputLength: 0
             });
        }
         function getSubCode3(){
              $('#subCode3').select2({
                 ajax: {
                     url: '@Url.Action("SC3Data", "PRPO")',
                     dataType: 'json',
                     delay: 250,
                     data: function (params) {
                         return {
                             searchTerm: params.term // Pass the searchTerm parameter
                         };
                     },
                     processResults: function (data) {
                         return {
                             results: data
                         };
                     },
                     cache: true

                 },
                 minimumInputLength: 0
             });
        }

        function getHistoryData() {
            $("#loading-overlay").show();
            $("#worklist").DataTable({
                "order": true,
                "scrollX": true,
                "bDestroy": true,
                "ajax": {
                    "url": '@Url.Action("getHistory", "PRPO")',
                    "type": "GET",
                    "datatype": "json",
                    "data": { dateStart: $("#dateStart").val(), dateEnd: $("#dateEnd").val(), flowStatus: $("#flowStatus").val() , vendorName:$("#vendorName").val(), department:$("#department").val() , project:$("#project").val() , mc: $("#mainCode").val() , sc1:$("#subCode1").val() , sc2:$("#subCode2").val() , sc3:$("#subCode3").val() , reqName:$("#reqName").val() },
                     "dataSrc": function (json) {
                        $("#loading-overlay").hide(); // ซ่อน overlay เมื่อโหลดเสร็จ
                       return json.data;
                     },
                     "error": function (xhr, error, thrown) {
                            $("#loading-overlay").hide(); // ซ่อน overlay เมื่อเกิด error
                            alert("Failed to load data please refresh.");
                     }
                },
                "columns": [
                    {
                        "data": "sPoNo", "render": function (data, type, row, meta) {

                            return "<a href='@Url.Action("ApprovePR", "PRPO")/" + data + "' target='_blank'>" + data + "</a>";

                        }
                    },
                    { "data": "sSupplierName" },
                    { "data": "sMainCode" },
                    { "data": "sSubCode1" },
                    { "data": "sSubCode2" },
                    {
                        "data": "fSumAmtCurrency", "render": function (data, type, row, meta) {


                            var SumAmtCurrency = parseFloat(data);
                            var formattedAmount = SumAmtCurrency.toLocaleString('en-US', {
                                style: 'decimal',
                                minimumFractionDigits: 2,
                                maximumFractionDigits: 2
                            });

                            return formattedAmount;

                        }
                    },
                    {
                        "data": "fSumAmtThb", "render": function (data, type, row, meta) {

                            var SumAmtTHB = parseFloat(data);
                            var formattedAmount = SumAmtTHB.toLocaleString('en-US', {
                                style: 'decimal',
                                minimumFractionDigits: 2,
                                maximumFractionDigits: 2
                            });

                            return formattedAmount;

                        }
                    },
                    {
                        "data": "sStatus", "render": function (data, type, row, meta) {

                            if(row.nStatus == 1){

                                return `<div class='alert'  style='background-color:#ddf0e9;color:#0f6848'>${data}</div>`;
                            }
                              if (row.nStatus == 2) {
                                return `<div class='alert alert-info'>${data}</div>`;
                            }
                            if (row.nStatus < 5) {
                                return `<div class='alert alert-warning'>${data}</div>`;
                            } else if (row.nStatus == 5) {
                                return `<div class='alert alert-success'>${data}</div>`;
                            }
                            else if (row.nStatus > 5) {
                                return `<div class='alert alert-danger'>${data}</div>`;
                            }


                        }
                    },

                    {
                        "data": "dCreated", "render": function (data, type, row, meta) {

                            return moment(data).format("DD-MM-YYYY HH:mm:ss");

                        }
                    },
                    {
                        "data": "sStatus", "render": function (data, type, row, meta) {

                           

                            if (row.sCreatedBy == '@sId.Value') {
                                 var deleteBtn = `<button class="btn btn-circle btn-danger btn-sm ml-1" onclick="deletePO('${row.uPoID}')"> <i class="fas fa-trash"></i> </button>`;

                                  var updateBtn = "";
                                 if((row.nStatus == 0 || row.nStatus == 1 || row.nStatus == 4)){
                                        updateBtn = "<a href='@Url.Action("CreateOrEdit", "PRPO")?gID=" + row.uPoID + "' class='btn btn-primary btn-circle btn-sm'><i class='fas fa-edit' aria-hidden='true'></i></a>";
                                 }
                                 var duplicateBtn = "";
                                 if((row.nStatus == 5)){
                                      duplicateBtn = `<button class="btn btn-circle btn-success btn-sm" onclick="duplicatePO('${row.uPoID}')"> <i class="fas fa-clone"></i> </button>`;
                                 }



                                return updateBtn + duplicateBtn + deleteBtn;
                            }

                            var positionLevel = '@claimsValue.Value';

                            if (positionLevel == '2' && row.nStatus >= 4) {
                                var updateBtn = "<a href='@Url.Action("CreateOrEdit", "PRPO")?gID=" + row.uPoID + "' class='btn btn-primary btn-circle btn-sm'><i class='fas fa-edit' aria-hidden='true'></i></a>";
                               // var deleteBtn = "";

                                return updateBtn ;
                            }


                             

                            return "";

                        }
                    }

                ]



            });
        }

        function duplicatePO(poId) {
            if (!confirm('Do you want to duplicate this PO?')) return;
            debugger
            $.ajax({
                url: '@Url.Action("duplicateDraftPO", "PRPO")', // URL ของ Controller
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ guid: poId }),
                success: function (response) {
                    if (response.status) {
                        window.location.href = '@Url.Action("CreateOrEdit", "PRPO")' + '?gID=' + response.message;
                    }
                },
                error: function (response) {
                    debugger;
                    alert(`Error occurred while duplicating PO : ${response.responseText}`);
                }
            });
        }

         function deletePO(poId) {
            if (!confirm('Do you want to delete this PO?')) return;

            $.ajax({
                url: '@Url.Action("deletePO", "PRPO")', // URL ของ Controller
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ guid: poId }),
                success: function (response) {
                    if (response.status) {
                        $('#worklist').DataTable().ajax.reload();
                        alert('PO deleted successfully! Please check if the refund is correct.');
                    }
                },
                error: function (response) {

                    alert(`Error occurred while delete PO : ${response.responseText}`);
                }
            });
        }
    </script>
}