@{
    ViewData["Title"] = "Users List";
}
<link href="~/datatables/css/datatables.bootstrap5.min.css" rel="stylesheet" />

<div class="card o-hidden border-0 shadow-sm mt-1">
    <div class="card-header bg-primary">
        <div class="d-flex justify-content-between align-items-center">

            <div>
                <h4 class="text-white">Users List</h4>
            </div>
            <div>
                <div> <a href="@Url.Action("InsertUpdate","UserManage")" class="btn btn-success btn-sm w-100"><i class="fa fa-plus"></i> Create</a></div>
                @*<a href="@Url.Action("InsertUpdate","Customer")" class="btn btn-success btn-sm"><i class="fa fa-plus"></i> Create</a>*@
            </div>
        </div>

        <div class="row d-flex align-items-end">
            <div class="col-lg-12 col-md-12 col-sm-12">
            </div>
        </div>
    </div>
    <div class="card-body ">
        <div class="table-responsive">
            <table id="userList" class="table table-striped text-center table-bordered align-self-center table-hover w-100 table-sm small">
                <thead>
                    <tr class="bg bg-primary text-white">
                        <th>Username</th>
                        <th>Name</th>
                        <th>E-Mail</th>
                        <th>Department</th>
                        <th>Active</th>
                        <th>#Action</th>
                    </tr>
                </thead>

            </table>
        </div>
    </div>

</div>
@section Scripts {
    <script src="~/js/moment.min.js"></script>
    <script src="~/datatables/js/jquery.datatables.min.js"></script>
    <script src="~/datatables/js/datatables.bootstrap5.js"></script>
    <script>
        $(function () {
            $("#userList").DataTable({
                "order": [[0, "desc"]],
                "scrollX": true,
                "ajax": {
                    "url": '@Url.Action("getUser", "UserManage")',
                    "type": "GET",
                    "datatype": "json"
                },
                "columns": [
                    {
                        "data": "nEmpId", "render": function (data, type, row, meta) {
                            return "<a href='@Url.Action("insertupdate", "userManage")?userID=" + data + "'>" + row.sEmpUsername + "</a>";
                        }
                    },
                    { "data": "sEmpName" },
                    { "data": "sEmpEmail" },
                    { "data": "sDepartment" },
                    { "data": "bActive" },
                    {
                        "data": "nEmpId", "render": function (data, type, row, meta) {



                            return "<button type='button' onclick='DeleteUser(" + JSON.stringify(row) + ")' class='btn btn-danger btn-circle btn-sm'><i class='fas fa-trash' aria-hidden='true'></i></button>";

                        }
                    }
                ]

            });

            

        });

        function DeleteUser(data) {
            
            var confirmation = confirm('Are you sure you want to delete this username : ' + data.sEmpUsername + '?');

            if (!confirmation) {
                return;
            }
            $.ajax({
                type: 'POST',
                url: '@Url.Action("deleteUser", "userManage")',
                data: { data: data.nEmpId },
                success: function (result) {

                    alertPopup(`${result.message}`).then((result) => {
                        if (result.isConfirmed) {
                            var url = '@Url.Action("index", "userManage")';
                            window.location.href = url;
                        }
                    });
                    console.log(result);
                },
                error: function (result) {
                    alertErrorPopup(`Failed to Delete the Data : ${result.responseText}`);

                }
            });

        }

    </script>
}