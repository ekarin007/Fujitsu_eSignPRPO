
@{
    ViewData["Title"] = "Currency List";
}
<link href="~/datatables/css/datatables.bootstrap5.min.css" rel="stylesheet" />

<div class="card o-hidden border-0 shadow-sm mt-1">
    <div class="card-header bg-primary">
        <div class="d-flex justify-content-between align-items-center">

            <div>
                <h4 class="text-white">Currency List</h4>
            </div>
            <div>
                <div> <a href="@Url.Action("InsertUpdate","CurrencyManage")" class="btn btn-success btn-sm w-100"><i class="fa fa-plus"></i> Create</a></div>
                @*<a href="@Url.Action("InsertUpdate","Customer")" class="btn btn-success btn-sm"><i class="fa fa-plus"></i> Create</a>*@
            </div>
        </div>

        <div class="row d-flex align-items-end">
            <div class="col-lg-12 col-md-12 col-sm-12">
            </div>
        </div>
    </div>
    <div class="card-body ">
        <div class="table-responsive">
            <table id="userList" class="table table-striped text-center table-bordered align-self-center table-hover w-100 table-sm small">
                <thead>
                    <tr class="bg bg-primary text-white">
                        <th>Currency Code</th>
                        <th>Currency Name</th>
                        <th>#Action</th>
                    </tr>
                </thead>

            </table>
        </div>
    </div>

</div>
@section Scripts {
    <script src="~/js/moment.min.js"></script>
    <script src="~/datatables/js/jquery.datatables.min.js"></script>
    <script src="~/datatables/js/datatables.bootstrap5.js"></script>
    <script>
        $(function () {
            $("#userList").DataTable({
                "order": [[0, "desc"]],
                "scrollX": true,
                "ajax": {
                    "url": '@Url.Action("getCurrency", "CurrencyManage")',
                    "type": "GET",
                    "datatype": "json"
                },
                "columns": [
                    {
                        "data": "currencyCode", "render": function (data, type, row, meta) {
                            return "<a href='@Url.Action("insertupdate", "CurrencyManage")?currID=" + data + "'>" + data + "</a>";
                        }
                    },
                    { "data": "currencyName" },

                    {
                        "data": "currencyCode", "render": function (data, type, row, meta) {



                            return "<button type='button' onclick='DeleteCurr(" + JSON.stringify(row) + ")' class='btn btn-danger btn-circle btn-sm'><i class='fas fa-trash' aria-hidden='true'></i></button>";

                        }
                    }
                ]

            });
         });

        function DeleteCurr(data) {
          
            var confirmation = confirm('Are you sure you want to delete this currency : ' + data.currencyCode + '?');

            if (!confirmation) {
                return;
            }
            $.ajax({
                type: 'POST',
                url: '@Url.Action("deleteCurr", "CurrencyManage")',
                data: { data: data.currencyCode },
                success: function (result) {

                    alertPopup(`${result.message}`).then((result) => {
                        if (result.isConfirmed) {
                            var url = '@Url.Action("index", "CurrencyManage")';
                            window.location.href = url;
                        }
                    });
                    console.log(result);
                },
                error: function (result) {
                    alertErrorPopup(`Failed to Delete the Data : ${result.responseText}`);

                }
            });

        }

    </script>
}